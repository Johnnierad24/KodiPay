# Server Configuration
PORT=5000
NODE_ENV=development

# Production hardening (leave unset/false for local development)
# Trust one reverse-proxy hop (Render/Railway/Nginx) so rate limiting sees real client IPs
TRUST_PROXY=false
# Comma-separated allowlist of browser origins; unset = allow all (dev only)
CORS_ORIGINS=

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kodipay
DB_USER=your_username
DB_PASSWORD=your_password
# Set true for managed Postgres (Render/Railway/Supabase/Heroku); false for local
DB_SSL=false

# Authentication (JWT)
JWT_SECRET=your_jwt_secret_key

# Google Sign-In (OAuth)
# The **Web** OAuth client ID from Google Cloud Console. The mobile app sends a
# Google ID token; the backend verifies its audience matches this value.
# Leave unset to disable Google sign-in (the /auth/google endpoint returns 503).
GOOGLE_CLIENT_ID=your-web-oauth-client-id.apps.googleusercontent.com

# M-Pesa Integration (Safaricom Daraja API)
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_mpesa_passkey
# Base callback URL WITHOUT the secret below — the app appends MPESA_CALLBACK_SECRET for you
MPESA_CALLBACK_URL=https://your-domain.com/api/payments/mpesa/callback
MPESA_ENV=sandbox
# Shortcode type: 'paybill' (CustomerPayBillOnline) or 'till' (CustomerBuyGoodsOnline)
MPESA_SHORTCODE_TYPE=paybill

# --- Callback security (the callback is a public webhook; harden it before going live) ---
# Unguessable token appended to the callback path so only Safaricom can reach it.
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MPESA_CALLBACK_SECRET=
# Re-confirm each "success" callback with Safaricom before crediting (defeats forged
# callbacks). Default: on when MPESA_ENV=production, off in sandbox. Override true|false.
MPESA_VERIFY_CALLBACK=
# Optional defense in depth: comma-separated Safaricom egress IPs or dotted prefixes
# (e.g. 196.201.214.,196.201.213.). Requires TRUST_PROXY=true behind a proxy. Empty = off.
MPESA_ALLOWED_IPS=

# SMS Integration (AfricasTalking)
SMS_PROVIDER=africastalking
SMS_USERNAME=your_sms_username
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=KodiPay
SMS_ENV=sandbox

# OpenAI Configuration (Chatbot)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=500

# Firebase Configuration (Push Notifications & Storage)
# Note: FIREBASE_SERVICE_ACCOUNT should be a JSON string of your service account key file
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
