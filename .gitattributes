# Normalize line endings across the repo.
# Git stores text files with LF internally and checks them out with the
# platform-native ending, so Windows clients stop reporting spurious
# "whole file changed" diffs caused by core.autocrlf.

# Default: let Git decide what's text and normalize it to LF in the repo.
* text=auto

# Source / text files — always LF in the repo.
*.dart      text eol=lf
*.js        text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.ts        text eol=lf
*.json      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.md        text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.xml       text eol=lf
*.svg       text eol=lf
*.sh        text eol=lf
*.swift     text eol=lf
*.kt        text eol=lf
*.java      text eol=lf
*.gradle    text eol=lf
*.h         text eol=lf
*.m         text eol=lf
*.cc        text eol=lf
*.cpp       text eol=lf
*.plist     text eol=lf
*.pbxproj   text eol=lf merge=union
*.gitignore text eol=lf
*.env       text eol=lf

# Windows-native files — keep CRLF.
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf
*.sln       text eol=crlf
*.vcxproj   text eol=crlf

# Binary files — never touch.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.pdf       binary
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary
*.jar       binary
*.keystore  binary
*.jks       binary
*.p12       binary
